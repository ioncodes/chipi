phd           op=0x0B | "phd"
pld           op=0x2B | "pld"
phk           op=0x4B | "phk"
pea_abs       op=0xF4 addr:word16 | "pea ${addr:04x:sym}"
pei_idp       op=0xD4 dp:byte8 | "pei (${dp:02x})"
per_rell      op=0x62 disp:rel16 | "per ${disp:rel}"

tax           op=0xAA | "tax"
txa           op=0x8A | "txa"
tay           op=0xA8 | "tay"
tya           op=0x98 | "tya"
tsx           op=0xBA | "tsx"
