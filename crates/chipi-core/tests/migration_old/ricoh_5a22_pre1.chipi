clc           op=0x18 | "clc"
sec           op=0x38 | "sec"
cli           op=0x58 | "cli"
sei           op=0x78 | "sei"
cld           op=0xD8 | "cld"
sed           op=0xF8 | "sed"
clv           op=0xB8 | "clv"

rep_imm       op=0xC2 mask:byte8 | "rep #${mask:02x}"
sep_imm       op=0xE2 mask:byte8 | "sep #${mask:02x}"
xce           op=0xFB | "xce"

mvn_bm        op=0x54 dst:byte8 src:byte8 | "mvn ${src:02x},${dst:02x}"
mvp_bm        op=0x44 dst:byte8 src:byte8 | "mvp ${src:02x},${dst:02x}"

nop           op=0xEA | "nop"
brk_imm       op=0x00 sig:byte8 | "brk #${sig:02x}"
cop_imm       op=0x02 sig:byte8 | "cop #${sig:02x}"
wdm_imm       op=0x42 sig:byte8 | "wdm #${sig:02x}"
stp           op=0xDB | "stp"
wai           op=0xCB | "wai"
xba           op=0xEB | "xba"

dispatch branches   { bra_rel, beq_rel, bne_rel, bcc_rel, bcs_rel, bpl_rel, bmi_rel, bvc_rel, bvs_rel, brl_rell }
dispatch flag_ops   { clc, sec, cli, sei, cld, sed, clv }
dispatch flag_mask  { rep_imm, sep_imm }
dispatch sw_trap    { brk_imm, cop_imm }
dispatch reg_step   { inc_a, dec_a, inx, iny, dex, dey }
dispatch store      { sta_idx, sta_sr, sta_dp, sta_idl, sta_abs, sta_abl, sta_idy, sta_idp, sta_isy, sta_dpx, sta_idly, sta_aby, sta_abx, sta_alx, stx_dp, stx_abs, stx_dpy, sty_dp, sty_abs, sty_dpx, stz_dp, stz_dpx, stz_abs, stz_abx }
dispatch load       { lda_idx, lda_sr, lda_dp, lda_idl, lda_imm_m16, lda_imm_m8, lda_abs, lda_abl, lda_idy, lda_idp, lda_isy, lda_dpx, lda_idly, lda_aby, lda_abx, lda_alx, ldx_imm_x16, ldx_imm_x8, ldx_dp, ldx_abs, ldx_dpy, ldx_aby, ldy_imm_x16, ldy_imm_x8, ldy_dp, ldy_abs, ldy_dpx, ldy_abx }
