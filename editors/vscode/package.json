{
  "name": "chipi",
  "displayName": "chipi",
  "description": "Syntax highlighting, snippets and a file icon for the chipi instruction-set DSL (.chipi).",
  "version": "1.0.0",
  "publisher": "ioncodes",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ioncodes/chipi"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "chipi",
        "aliases": [
          "chipi",
          "Chipi"
        ],
        "extensions": [
          ".chipi"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/chipi-file.svg",
          "dark": "./icons/chipi-file.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "chipi",
        "scopeName": "source.chipi",
        "path": "./syntaxes/chipi.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "chipi",
        "path": "./snippets/chipi.json"
      }
    ]
  },
  "scripts": {
    "test": "node test/tokenize.mjs"
  }
}