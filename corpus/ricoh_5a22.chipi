decoder Ricoh5A22 {
    width     = 8         # 8-bit fetch unit (one opcode byte)
    bit_order = lsb0
    endian    = little    # operands are little-endian in the byte stream
    mode m: bool = 1      # accumulator/memory width: 1 = 8-bit, 0 = 16-bit
    mode x: bool = 1      # index (X/Y) width:        1 = 8-bit, 0 = 16-bit
}

selector op [0:7]

operand byte8  = u8  fetch(8)
operand word16 = u16 fetch(16)
operand long24 = u24 fetch(24)
operand rel8   = i8  fetch(8)
operand rel16  = i16 fetch(16)

# Immediates fetch at the width the host mode selects: one byte when the
# accumulator (m) or index (x) registers are 8-bit, two when 16-bit. One leaf
# per instruction covers both widths.

lda.idx       op=0xA1 dp:byte8 | "lda (${dp:02x},x)"
lda.sr        op=0xA3 sr:byte8 | "lda ${sr:02x},s"
lda.dp        op=0xA5 dp:byte8 | "lda ${dp:02x}"
lda.idl       op=0xA7 dp:byte8 | "lda [${dp:02x}]"
lda.imm       op=0xA9 imm:u16 = fetch(m ? 8 : 16) | "lda #{m?${imm:02x}:${imm:04x}}"
lda.abs       op=0xAD addr:word16 | "lda ${addr:04x:sym}"
lda.abl       op=0xAF addr:long24 | "lda ${addr:06x:sym}"
lda.idy       op=0xB1 dp:byte8 | "lda (${dp:02x}),y"
lda.idp       op=0xB2 dp:byte8 | "lda (${dp:02x})"
lda.isy       op=0xB3 sr:byte8 | "lda (${sr:02x},s),y"
lda.dpx       op=0xB5 dp:byte8 | "lda ${dp:02x},x"
lda.idly      op=0xB7 dp:byte8 | "lda [${dp:02x}],y"
lda.aby       op=0xB9 addr:word16 | "lda ${addr:04x:sym},y"
lda.abx       op=0xBD addr:word16 | "lda ${addr:04x:sym},x"
lda.alx       op=0xBF addr:long24 | "lda ${addr:06x:sym},x"
ldx.immx      op=0xA2 imm:u16 = fetch(x ? 8 : 16) | "ldx #{x?${imm:02x}:${imm:04x}}"
ldx.dp        op=0xA6 dp:byte8 | "ldx ${dp:02x}"
ldx.abs       op=0xAE addr:word16 | "ldx ${addr:04x:sym}"
ldx.dpy       op=0xB6 dp:byte8 | "ldx ${dp:02x},y"
ldx.aby       op=0xBE addr:word16 | "ldx ${addr:04x:sym},y"
ldy.immx      op=0xA0 imm:u16 = fetch(x ? 8 : 16) | "ldy #{x?${imm:02x}:${imm:04x}}"
ldy.dp        op=0xA4 dp:byte8 | "ldy ${dp:02x}"
ldy.abs       op=0xAC addr:word16 | "ldy ${addr:04x:sym}"
ldy.dpx       op=0xB4 dp:byte8 | "ldy ${dp:02x},x"
ldy.abx       op=0xBC addr:word16 | "ldy ${addr:04x:sym},x"

sta.idx       op=0x81 dp:byte8 | "sta (${dp:02x},x)"
sta.sr        op=0x83 sr:byte8 | "sta ${sr:02x},s"
sta.dp        op=0x85 dp:byte8 | "sta ${dp:02x}"
sta.idl       op=0x87 dp:byte8 | "sta [${dp:02x}]"
sta.abs       op=0x8D addr:word16 | "sta ${addr:04x:sym}"
sta.abl       op=0x8F addr:long24 | "sta ${addr:06x:sym}"
sta.idy       op=0x91 dp:byte8 | "sta (${dp:02x}),y"
sta.idp       op=0x92 dp:byte8 | "sta (${dp:02x})"
sta.isy       op=0x93 sr:byte8 | "sta (${sr:02x},s),y"
sta.dpx       op=0x95 dp:byte8 | "sta ${dp:02x},x"
sta.idly      op=0x97 dp:byte8 | "sta [${dp:02x}],y"
sta.aby       op=0x99 addr:word16 | "sta ${addr:04x:sym},y"
sta.abx       op=0x9D addr:word16 | "sta ${addr:04x:sym},x"
sta.alx       op=0x9F addr:long24 | "sta ${addr:06x:sym},x"
stx.dp        op=0x86 dp:byte8 | "stx ${dp:02x}"
stx.abs       op=0x8E addr:word16 | "stx ${addr:04x:sym}"
stx.dpy       op=0x96 dp:byte8 | "stx ${dp:02x},y"
sty.dp        op=0x84 dp:byte8 | "sty ${dp:02x}"
sty.abs       op=0x8C addr:word16 | "sty ${addr:04x:sym}"
sty.dpx       op=0x94 dp:byte8 | "sty ${dp:02x},x"
stz.dp        op=0x64 dp:byte8 | "stz ${dp:02x}"
stz.dpx       op=0x74 dp:byte8 | "stz ${dp:02x},x"
stz.abs       op=0x9C addr:word16 | "stz ${addr:04x:sym}"
stz.abx       op=0x9E addr:word16 | "stz ${addr:04x:sym},x"

adc.idx       op=0x61 dp:byte8 | "adc (${dp:02x},x)"
adc.sr        op=0x63 sr:byte8 | "adc ${sr:02x},s"
adc.dp        op=0x65 dp:byte8 | "adc ${dp:02x}"
adc.idl       op=0x67 dp:byte8 | "adc [${dp:02x}]"
adc.imm       op=0x69 imm:u16 = fetch(m ? 8 : 16) | "adc #{m?${imm:02x}:${imm:04x}}"
adc.abs       op=0x6D addr:word16 | "adc ${addr:04x:sym}"
adc.abl       op=0x6F addr:long24 | "adc ${addr:06x:sym}"
adc.idy       op=0x71 dp:byte8 | "adc (${dp:02x}),y"
adc.idp       op=0x72 dp:byte8 | "adc (${dp:02x})"
adc.isy       op=0x73 sr:byte8 | "adc (${sr:02x},s),y"
adc.dpx       op=0x75 dp:byte8 | "adc ${dp:02x},x"
adc.idly      op=0x77 dp:byte8 | "adc [${dp:02x}],y"
adc.aby       op=0x79 addr:word16 | "adc ${addr:04x:sym},y"
adc.abx       op=0x7D addr:word16 | "adc ${addr:04x:sym},x"
adc.alx       op=0x7F addr:long24 | "adc ${addr:06x:sym},x"
sbc.idx       op=0xE1 dp:byte8 | "sbc (${dp:02x},x)"
sbc.sr        op=0xE3 sr:byte8 | "sbc ${sr:02x},s"
sbc.dp        op=0xE5 dp:byte8 | "sbc ${dp:02x}"
sbc.idl       op=0xE7 dp:byte8 | "sbc [${dp:02x}]"
sbc.imm       op=0xE9 imm:u16 = fetch(m ? 8 : 16) | "sbc #{m?${imm:02x}:${imm:04x}}"
sbc.abs       op=0xED addr:word16 | "sbc ${addr:04x:sym}"
sbc.abl       op=0xEF addr:long24 | "sbc ${addr:06x:sym}"
sbc.idy       op=0xF1 dp:byte8 | "sbc (${dp:02x}),y"
sbc.idp       op=0xF2 dp:byte8 | "sbc (${dp:02x})"
sbc.isy       op=0xF3 sr:byte8 | "sbc (${sr:02x},s),y"
sbc.dpx       op=0xF5 dp:byte8 | "sbc ${dp:02x},x"
sbc.idly      op=0xF7 dp:byte8 | "sbc [${dp:02x}],y"
sbc.aby       op=0xF9 addr:word16 | "sbc ${addr:04x:sym},y"
sbc.abx       op=0xFD addr:word16 | "sbc ${addr:04x:sym},x"
sbc.alx       op=0xFF addr:long24 | "sbc ${addr:06x:sym},x"

and.idx       op=0x21 dp:byte8 | "and (${dp:02x},x)"
and.sr        op=0x23 sr:byte8 | "and ${sr:02x},s"
and.dp        op=0x25 dp:byte8 | "and ${dp:02x}"
and.idl       op=0x27 dp:byte8 | "and [${dp:02x}]"
and.imm       op=0x29 imm:u16 = fetch(m ? 8 : 16) | "and #{m?${imm:02x}:${imm:04x}}"
and.abs       op=0x2D addr:word16 | "and ${addr:04x:sym}"
and.abl       op=0x2F addr:long24 | "and ${addr:06x:sym}"
and.idy       op=0x31 dp:byte8 | "and (${dp:02x}),y"
and.idp       op=0x32 dp:byte8 | "and (${dp:02x})"
and.isy       op=0x33 sr:byte8 | "and (${sr:02x},s),y"
and.dpx       op=0x35 dp:byte8 | "and ${dp:02x},x"
and.idly      op=0x37 dp:byte8 | "and [${dp:02x}],y"
and.aby       op=0x39 addr:word16 | "and ${addr:04x:sym},y"
and.abx       op=0x3D addr:word16 | "and ${addr:04x:sym},x"
and.alx       op=0x3F addr:long24 | "and ${addr:06x:sym},x"
ora.idx       op=0x01 dp:byte8 | "ora (${dp:02x},x)"
ora.sr        op=0x03 sr:byte8 | "ora ${sr:02x},s"
ora.dp        op=0x05 dp:byte8 | "ora ${dp:02x}"
ora.idl       op=0x07 dp:byte8 | "ora [${dp:02x}]"
ora.imm       op=0x09 imm:u16 = fetch(m ? 8 : 16) | "ora #{m?${imm:02x}:${imm:04x}}"
ora.abs       op=0x0D addr:word16 | "ora ${addr:04x:sym}"
ora.abl       op=0x0F addr:long24 | "ora ${addr:06x:sym}"
ora.idy       op=0x11 dp:byte8 | "ora (${dp:02x}),y"
ora.idp       op=0x12 dp:byte8 | "ora (${dp:02x})"
ora.isy       op=0x13 sr:byte8 | "ora (${sr:02x},s),y"
ora.dpx       op=0x15 dp:byte8 | "ora ${dp:02x},x"
ora.idly      op=0x17 dp:byte8 | "ora [${dp:02x}],y"
ora.aby       op=0x19 addr:word16 | "ora ${addr:04x:sym},y"
ora.abx       op=0x1D addr:word16 | "ora ${addr:04x:sym},x"
ora.alx       op=0x1F addr:long24 | "ora ${addr:06x:sym},x"
eor.idx       op=0x41 dp:byte8 | "eor (${dp:02x},x)"
eor.sr        op=0x43 sr:byte8 | "eor ${sr:02x},s"
eor.dp        op=0x45 dp:byte8 | "eor ${dp:02x}"
eor.idl       op=0x47 dp:byte8 | "eor [${dp:02x}]"
eor.imm       op=0x49 imm:u16 = fetch(m ? 8 : 16) | "eor #{m?${imm:02x}:${imm:04x}}"
eor.abs       op=0x4D addr:word16 | "eor ${addr:04x:sym}"
eor.abl       op=0x4F addr:long24 | "eor ${addr:06x:sym}"
eor.idy       op=0x51 dp:byte8 | "eor (${dp:02x}),y"
eor.idp       op=0x52 dp:byte8 | "eor (${dp:02x})"
eor.isy       op=0x53 sr:byte8 | "eor (${sr:02x},s),y"
eor.dpx       op=0x55 dp:byte8 | "eor ${dp:02x},x"
eor.idly      op=0x57 dp:byte8 | "eor [${dp:02x}],y"
eor.aby       op=0x59 addr:word16 | "eor ${addr:04x:sym},y"
eor.abx       op=0x5D addr:word16 | "eor ${addr:04x:sym},x"
eor.alx       op=0x5F addr:long24 | "eor ${addr:06x:sym},x"

cmp.idx       op=0xC1 dp:byte8 | "cmp (${dp:02x},x)"
cmp.sr        op=0xC3 sr:byte8 | "cmp ${sr:02x},s"
cmp.dp        op=0xC5 dp:byte8 | "cmp ${dp:02x}"
cmp.idl       op=0xC7 dp:byte8 | "cmp [${dp:02x}]"
cmp.imm       op=0xC9 imm:u16 = fetch(m ? 8 : 16) | "cmp #{m?${imm:02x}:${imm:04x}}"
cmp.abs       op=0xCD addr:word16 | "cmp ${addr:04x:sym}"
cmp.abl       op=0xCF addr:long24 | "cmp ${addr:06x:sym}"
cmp.idy       op=0xD1 dp:byte8 | "cmp (${dp:02x}),y"
cmp.idp       op=0xD2 dp:byte8 | "cmp (${dp:02x})"
cmp.isy       op=0xD3 sr:byte8 | "cmp (${sr:02x},s),y"
cmp.dpx       op=0xD5 dp:byte8 | "cmp ${dp:02x},x"
cmp.idly      op=0xD7 dp:byte8 | "cmp [${dp:02x}],y"
cmp.aby       op=0xD9 addr:word16 | "cmp ${addr:04x:sym},y"
cmp.abx       op=0xDD addr:word16 | "cmp ${addr:04x:sym},x"
cmp.alx       op=0xDF addr:long24 | "cmp ${addr:06x:sym},x"
cpx.immx      op=0xE0 imm:u16 = fetch(x ? 8 : 16) | "cpx #{x?${imm:02x}:${imm:04x}}"
cpx.dp        op=0xE4 dp:byte8 | "cpx ${dp:02x}"
cpx.abs       op=0xEC addr:word16 | "cpx ${addr:04x:sym}"
cpy.immx      op=0xC0 imm:u16 = fetch(x ? 8 : 16) | "cpy #{x?${imm:02x}:${imm:04x}}"
cpy.dp        op=0xC4 dp:byte8 | "cpy ${dp:02x}"
cpy.abs       op=0xCC addr:word16 | "cpy ${addr:04x:sym}"
bit.dp        op=0x24 dp:byte8 | "bit ${dp:02x}"
bit.abs       op=0x2C addr:word16 | "bit ${addr:04x:sym}"
bit.dpx       op=0x34 dp:byte8 | "bit ${dp:02x},x"
bit.abx       op=0x3C addr:word16 | "bit ${addr:04x:sym},x"
bit.imm       op=0x89 imm:u16 = fetch(m ? 8 : 16) | "bit #{m?${imm:02x}:${imm:04x}}"

inc.a         op=0x1A | "inc a"
inc.dp        op=0xE6 dp:byte8 | "inc ${dp:02x}"
inc.abs       op=0xEE addr:word16 | "inc ${addr:04x:sym}"
inc.dpx       op=0xF6 dp:byte8 | "inc ${dp:02x},x"
inc.abx       op=0xFE addr:word16 | "inc ${addr:04x:sym},x"
dec.a         op=0x3A | "dec a"
dec.dp        op=0xC6 dp:byte8 | "dec ${dp:02x}"
dec.abs       op=0xCE addr:word16 | "dec ${addr:04x:sym}"
dec.dpx       op=0xD6 dp:byte8 | "dec ${dp:02x},x"
dec.abx       op=0xDE addr:word16 | "dec ${addr:04x:sym},x"
inx           op=0xE8 | "inx"
iny           op=0xC8 | "iny"
dex           op=0xCA | "dex"
dey           op=0x88 | "dey"

asl.dp        op=0x06 dp:byte8 | "asl ${dp:02x}"
asl.a         op=0x0A | "asl a"
asl.abs       op=0x0E addr:word16 | "asl ${addr:04x:sym}"
asl.dpx       op=0x16 dp:byte8 | "asl ${dp:02x},x"
asl.abx       op=0x1E addr:word16 | "asl ${addr:04x:sym},x"
lsr.dp        op=0x46 dp:byte8 | "lsr ${dp:02x}"
lsr.a         op=0x4A | "lsr a"
lsr.abs       op=0x4E addr:word16 | "lsr ${addr:04x:sym}"
lsr.dpx       op=0x56 dp:byte8 | "lsr ${dp:02x},x"
lsr.abx       op=0x5E addr:word16 | "lsr ${addr:04x:sym},x"
rol.dp        op=0x26 dp:byte8 | "rol ${dp:02x}"
rol.a         op=0x2A | "rol a"
rol.abs       op=0x2E addr:word16 | "rol ${addr:04x:sym}"
rol.dpx       op=0x36 dp:byte8 | "rol ${dp:02x},x"
rol.abx       op=0x3E addr:word16 | "rol ${addr:04x:sym},x"
ror.dp        op=0x66 dp:byte8 | "ror ${dp:02x}"
ror.a         op=0x6A | "ror a"
ror.abs       op=0x6E addr:word16 | "ror ${addr:04x:sym}"
ror.dpx       op=0x76 dp:byte8 | "ror ${dp:02x},x"
ror.abx       op=0x7E addr:word16 | "ror ${addr:04x:sym},x"

tsb.dp        op=0x04 dp:byte8 | "tsb ${dp:02x}"
tsb.abs       op=0x0C addr:word16 | "tsb ${addr:04x:sym}"
trb.dp        op=0x14 dp:byte8 | "trb ${dp:02x}"
trb.abs       op=0x1C addr:word16 | "trb ${addr:04x:sym}"

bpl.rel       op=0x10 disp:rel8 | "bpl ${disp:rel}"
bmi.rel       op=0x30 disp:rel8 | "bmi ${disp:rel}"
bvc.rel       op=0x50 disp:rel8 | "bvc ${disp:rel}"
bvs.rel       op=0x70 disp:rel8 | "bvs ${disp:rel}"
bcc.rel       op=0x90 disp:rel8 | "bcc ${disp:rel}"
bcs.rel       op=0xB0 disp:rel8 | "bcs ${disp:rel}"
bne.rel       op=0xD0 disp:rel8 | "bne ${disp:rel}"
beq.rel       op=0xF0 disp:rel8 | "beq ${disp:rel}"
bra.rel       op=0x80 disp:rel8 | "bra ${disp:rel}"
brl.rell      op=0x82 disp:rel16 | "brl ${disp:rel}"

jmp.abs       op=0x4C addr:word16 | "jmp ${addr:04x:sym}"
jmp.abl       op=0x5C addr:long24 | "jmp ${addr:06x:sym}"
jmp.ind       op=0x6C addr:word16 | "jmp (${addr:04x:sym})"
jmp.iax       op=0x7C addr:word16 | "jmp (${addr:04x:sym},x)"
jml.ial       op=0xDC addr:word16 | "jml [${addr:04x:sym}]"
jsr.abs       op=0x20 addr:word16 | "jsr ${addr:04x:sym}"
jsl.abl       op=0x22 addr:long24 | "jsl ${addr:06x:sym}"
jsr.iax       op=0xFC addr:word16 | "jsr (${addr:04x:sym},x)"
rts           op=0x60 | "rts"
rtl           op=0x6B | "rtl"
rti           op=0x40 | "rti"

pha           op=0x48 | "pha"
pla           op=0x68 | "pla"
phx           op=0xDA | "phx"
plx           op=0xFA | "plx"
phy           op=0x5A | "phy"
ply           op=0x7A | "ply"
php           op=0x08 | "php"
plp           op=0x28 | "plp"
phb           op=0x8B | "phb"
plb           op=0xAB | "plb"
phd           op=0x0B | "phd"
pld           op=0x2B | "pld"
phk           op=0x4B | "phk"
pea.abs       op=0xF4 addr:word16 | "pea ${addr:04x:sym}"
pei.idp       op=0xD4 dp:byte8 | "pei (${dp:02x})"
per.rell      op=0x62 disp:rel16 | "per ${disp:rel}"

tax           op=0xAA | "tax"
txa           op=0x8A | "txa"
tay           op=0xA8 | "tay"
tya           op=0x98 | "tya"
tsx           op=0xBA | "tsx"
txs           op=0x9A | "txs"
txy           op=0x9B | "txy"
tyx           op=0xBB | "tyx"
tcs           op=0x1B | "tcs"
tsc           op=0x3B | "tsc"
tcd           op=0x5B | "tcd"
tdc           op=0x7B | "tdc"

clc           op=0x18 | "clc"
sec           op=0x38 | "sec"
cli           op=0x58 | "cli"
sei           op=0x78 | "sei"
cld           op=0xD8 | "cld"
sed           op=0xF8 | "sed"
clv           op=0xB8 | "clv"

rep_imm       op=0xC2 mask:byte8 | "rep #${mask:02x}"
sep_imm       op=0xE2 mask:byte8 | "sep #${mask:02x}"
xce           op=0xFB | "xce"

mvn.bm        op=0x54 dst:byte8 src:byte8 | "mvn ${src:02x},${dst:02x}"
mvp.bm        op=0x44 dst:byte8 src:byte8 | "mvp ${src:02x},${dst:02x}"

nop           op=0xEA | "nop"
brk_imm       op=0x00 sig:byte8 | "brk #${sig:02x}"
cop_imm       op=0x02 sig:byte8 | "cop #${sig:02x}"
wdm_imm       op=0x42 sig:byte8 | "wdm #${sig:02x}"
stp           op=0xDB | "stp"
wai           op=0xCB | "wai"
xba           op=0xEB | "xba"

# Dispatch groups. Address-mode metadata rides on the form axis, so only
# groupings that cut across mnemonics are listed here.

dispatch branches   { bra.*, brl.*, beq.*, bne.*, bcc.*, bcs.*, bpl.*, bmi.*, bvc.*, bvs.* }
dispatch flag_ops   { clc, sec, cli, sei, cld, sed, clv }
dispatch flag_mask  { rep_imm, sep_imm }
dispatch sw_trap    { brk_imm, cop_imm }
dispatch reg_step   { inc.a, dec.a, inx, iny, dex, dey }
dispatch store      { sta.*, stx.*, sty.*, stz.* }
dispatch load       { lda.*, ldx.*, ldy.* }
dispatch alu        { adc.*, sbc.*, and.*, ora.*, eor.* }
dispatch compare    { cmp.*, cpx.*, cpy.* }
dispatch shift      { asl.*, lsr.*, rol.*, ror.* }
dispatch mem_step   { inc.dp, inc.abs, inc.dpx, inc.abx, dec.dp, dec.abs, dec.dpx, dec.abx }
dispatch bit_modify { tsb.*, trb.* }
dispatch transfer   { tax, txa, tay, tya, tsx, txs, txy, tyx, tcs, tsc, tcd, tdc }
dispatch push       { pha, phx, phy, php, phb, phd, phk, pea.*, pei.*, per.* }
dispatch pop        { pla, plx, ply, plp, plb, pld }
dispatch jump       { jmp.*, jml.* }
dispatch call       { jsr.*, jsl.* }
dispatch ret        { rts, rtl, rti }
dispatch block_move { mvn.*, mvp.* }
dispatch halt       { stp, wai }
