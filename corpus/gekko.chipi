# Gekko (PowerPC 750) - Nintendo GameCube CPU
# 32-bit opcodes, MSB0 bit ordering, big endian.

decoder Gekko {
    width = 32
    bit_order = msb0
    endian = big
}

selector primary [0:5]

# registers
operand gpr = u5 { display("r{}") }
operand fpr = u5 { display("f{}") }

# small unsigned fields that disassemble as plain decimals
operand d1 = u1 { display(dec) }
operand d3 = u3 { display(dec) }
operand d4 = u4 { display(dec) }
operand d5 = u5 { display(dec) }
operand d8 = u8 { display(dec) }

# branch-condition mnemonic suffixes, keyed by the low two bits of BI (the CR bit within a field)
operand bc_true  = u2 { display(names { 0 => "lt", 1 => "gt", 2 => "eq", _ => "so" }) }
operand bc_false = u2 { display(names { 0 => "ge", 1 => "le", 2 => "ne", _ => "ns" }) }

# special-purpose register names, keyed by the ("deswapped") SPR number; unknown SPRs show the number
operand spr_name = u16 {
    display(names {
        1 => "xer", 8 => "lr", 9 => "ctr", 18 => "dsisr", 19 => "dar", 22 => "dec",
        25 => "sdr1", 26 => "srr0", 27 => "srr1",
        272 => "sprg0", 273 => "sprg1", 274 => "sprg2", 275 => "sprg3",
        268 => "tbl", 269 => "tbu", 282 => "ear", 284 => "tbl", 285 => "tbu", 287 => "pvr",
        528 => "ibat0u", 529 => "ibat0l", 530 => "ibat1u", 531 => "ibat1l",
        532 => "ibat2u", 533 => "ibat2l", 534 => "ibat3u", 535 => "ibat3l",
        536 => "dbat0u", 537 => "dbat0l", 538 => "dbat1u", 539 => "dbat1l",
        540 => "dbat2u", 541 => "dbat2l", 542 => "dbat3u", 543 => "dbat3l",
        912 => "gqr0", 913 => "gqr1", 914 => "gqr2", 915 => "gqr3",
        916 => "gqr4", 917 => "gqr5", 918 => "gqr6", 919 => "gqr7",
        920 => "hid2", 921 => "wpar", 922 => "dmau", 923 => "dmal",
        936 => "ummcr0", 937 => "upmc1", 938 => "upmc2", 939 => "usia",
        940 => "ummcr1", 941 => "upmc3", 942 => "upmc4", 943 => "usda",
        952 => "mmcr0", 953 => "pmc1", 954 => "pmc2", 955 => "sia",
        956 => "mmcr1", 957 => "pmc3", 958 => "pmc4", 959 => "sda",
        1008 => "hid0", 1009 => "hid1", 1010 => "iabr", 1013 => "dabr", 1017 => "l2cr",
        1019 => "ictc", 1020 => "thrm1", 1021 => "thrm2", 1022 => "thrm3",
        _ => dec
    })
}

# immediates
type uimm        = u16 { display(hex) }
type simm12      = i32 { sign_extend(12), display(signed_hex) }
type simm16      = i32 { sign_extend(16), display(signed_hex) }
type simm24      = i32 { sign_extend(24), shift_left(2), display(signed_hex) }
type disp        = i32 { sign_extend(16), display(signed_hex) }
type branch_disp = i32 { sign_extend(14), shift_left(2), display(signed_hex) }

# Recurring operand layouts, factored as forms. `uses` appends a form's fields to a
# leaf's own bindings; the extended-opcode constraints stay inline on each instruction.
form XO   { rd:gpr[6:10] ra:gpr[11:15] rb:gpr[16:20] oe:bool[21] rc:bool[31] }
form X_RD { rd:gpr[6:10] ra:gpr[11:15] rb:gpr[16:20] }
form X_RS { rs:gpr[6:10] ra:gpr[11:15] rb:gpr[16:20] }
form FPR3 { fd:fpr[6:10] fa:fpr[11:15] fb:fpr[16:20] rc:bool[31] }
form FPR4 { fd:fpr[6:10] fa:fpr[11:15] fb:fpr[16:20] fc:fpr[21:25] rc:bool[31] }
form D_LD { rd:gpr[6:10] ra:gpr[11:15] d:disp[16:31] }
form D_ST { rs:gpr[6:10] ra:gpr[11:15] d:disp[16:31] }

# ============================================================
# Primary opcode 3: twi (Trap Word Immediate)
# ============================================================
twi         primary=3 to:d5[6:10] ra:gpr[11:15] simm:simm16[16:31]
            | "twi {to}, {ra}, {simm}"

# ============================================================
# Primary opcode 4: Paired Single
# ============================================================

# PS Compare - X-form
ps_cmpu0    primary=4 crfd:d3[6:8] [9:10]=0 fa:fpr[11:15] fb:fpr[16:20] [21:30]=0 [31]=0
            | "ps_cmpu0 cr{crfd}, {fa}, {fb}"

ps_cmpo0    primary=4 crfd:d3[6:8] [9:10]=0 fa:fpr[11:15] fb:fpr[16:20] [21:30]=0b0000100000 [31]=0
            | "ps_cmpo0 cr{crfd}, {fa}, {fb}"

ps_cmpu1    primary=4 crfd:d3[6:8] [9:10]=0 fa:fpr[11:15] fb:fpr[16:20] [21:30]=0b0001000000 [31]=0
            | "ps_cmpu1 cr{crfd}, {fa}, {fb}"

ps_cmpo1    primary=4 crfd:d3[6:8] [9:10]=0 fa:fpr[11:15] fb:fpr[16:20] [21:30]=0b0001100000 [31]=0
            | "ps_cmpo1 cr{crfd}, {fa}, {fb}"

# PS Unary/Move - X-form ([11:15]=00000)
ps_res      primary=4 fd:fpr[6:10] [11:15]=0 fb:fpr[16:20] [21:30]=0b0000011000 rc:bool[31]
            | "ps_res{rc?.} {fd}, {fb}"

ps_rsqrte   primary=4 fd:fpr[6:10] [11:15]=0 fb:fpr[16:20] [21:30]=0b0000011010 rc:bool[31]
            | "ps_rsqrte{rc?.} {fd}, {fb}"

ps_neg      primary=4 fd:fpr[6:10] [11:15]=0 fb:fpr[16:20] [21:30]=0b0000101000 rc:bool[31]
            | "ps_neg{rc?.} {fd}, {fb}"

ps_mr       primary=4 fd:fpr[6:10] [11:15]=0 fb:fpr[16:20] [21:30]=0b0001001000 rc:bool[31]
            | "ps_mr{rc?.} {fd}, {fb}"

ps_nabs     primary=4 fd:fpr[6:10] [11:15]=0 fb:fpr[16:20] [21:30]=0b0010001000 rc:bool[31]
            | "ps_nabs{rc?.} {fd}, {fb}"

ps_abs      primary=4 fd:fpr[6:10] [11:15]=0 fb:fpr[16:20] [21:30]=0b0100001000 rc:bool[31]
            | "ps_abs{rc?.} {fd}, {fb}"

# PS Merge - X-form
ps_merge00  primary=4 uses FPR3 [21:30]=0b1000010000
            | "ps_merge00{rc?.} {fd}, {fa}, {fb}"

ps_merge01  primary=4 uses FPR3 [21:30]=0b1000110000
            | "ps_merge01{rc?.} {fd}, {fa}, {fb}"

ps_merge10  primary=4 uses FPR3 [21:30]=0b1001010000
            | "ps_merge10{rc?.} {fd}, {fa}, {fb}"

ps_merge11  primary=4 uses FPR3 [21:30]=0b1001110000
            | "ps_merge11{rc?.} {fd}, {fa}, {fb}"

# Quantized Load/Store - X-form
psq_lx      primary=4 fd:fpr[6:10] ra:gpr[11:15] rb:gpr[16:20] w:d1[21] i:d3[22:24] [25:30]=0b000110 [31]=0
            | "psq_lx {fd}, {ra}, {rb}, {w}, {i}"

psq_stx     primary=4 fs:fpr[6:10] ra:gpr[11:15] rb:gpr[16:20] w:d1[21] i:d3[22:24] [25:30]=0b000111 [31]=0
            | "psq_stx {fs}, {ra}, {rb}, {w}, {i}"

psq_lux     primary=4 fd:fpr[6:10] ra:gpr[11:15] rb:gpr[16:20] w:d1[21] i:d3[22:24] [25:30]=0b100110 [31]=0
            | "psq_lux {fd}, {ra}, {rb}, {w}, {i}"

psq_stux    primary=4 fs:fpr[6:10] ra:gpr[11:15] rb:gpr[16:20] w:d1[21] i:d3[22:24] [25:30]=0b100111 [31]=0
            | "psq_stux {fs}, {ra}, {rb}, {w}, {i}"

# PS Arithmetic - A-form (5-bit XO at [26:30])
ps_sum0     primary=4 uses FPR4 [26:30]=0b01010
            | "ps_sum0{rc?.} {fd}, {fa}, {fc}, {fb}"

ps_sum1     primary=4 uses FPR4 [26:30]=0b01011
            | "ps_sum1{rc?.} {fd}, {fa}, {fc}, {fb}"

ps_muls0    primary=4 fd:fpr[6:10] fa:fpr[11:15] [16:20]=0 fc:fpr[21:25] [26:30]=0b01100 rc:bool[31]
            | "ps_muls0{rc?.} {fd}, {fa}, {fc}"

ps_muls1    primary=4 fd:fpr[6:10] fa:fpr[11:15] [16:20]=0 fc:fpr[21:25] [26:30]=0b01101 rc:bool[31]
            | "ps_muls1{rc?.} {fd}, {fa}, {fc}"

ps_madds0   primary=4 uses FPR4 [26:30]=0b01110
            | "ps_madds0{rc?.} {fd}, {fa}, {fc}, {fb}"

ps_madds1   primary=4 uses FPR4 [26:30]=0b01111
            | "ps_madds1{rc?.} {fd}, {fa}, {fc}, {fb}"

ps_div      primary=4 uses FPR3 [21:25]=0 [26:30]=0b10010
            | "ps_div{rc?.} {fd}, {fa}, {fb}"

ps_sub      primary=4 uses FPR3 [21:25]=0 [26:30]=0b10100
            | "ps_sub{rc?.} {fd}, {fa}, {fb}"

ps_add      primary=4 uses FPR3 [21:25]=0 [26:30]=0b10101
            | "ps_add{rc?.} {fd}, {fa}, {fb}"

ps_sel      primary=4 uses FPR4 [26:30]=0b10111
            | "ps_sel{rc?.} {fd}, {fa}, {fc}, {fb}"

ps_mul      primary=4 fd:fpr[6:10] fa:fpr[11:15] [16:20]=0 fc:fpr[21:25] [26:30]=0b11001 rc:bool[31]
            | "ps_mul{rc?.} {fd}, {fa}, {fc}"

ps_msub     primary=4 uses FPR4 [26:30]=0b11100
            | "ps_msub{rc?.} {fd}, {fa}, {fc}, {fb}"

ps_madd     primary=4 uses FPR4 [26:30]=0b11101
            | "ps_madd{rc?.} {fd}, {fa}, {fc}, {fb}"

ps_nmsub    primary=4 uses FPR4 [26:30]=0b11110
            | "ps_nmsub{rc?.} {fd}, {fa}, {fc}, {fb}"

ps_nmadd    primary=4 uses FPR4 [26:30]=0b11111
            | "ps_nmadd{rc?.} {fd}, {fa}, {fc}, {fb}"

# Locked Cache Instruction
dcbz_l      primary=4 [6:10]=0 ra:gpr[11:15] rb:gpr[16:20] [21:30]=0b1111110110 [31]=0
            | "dcbz_l {ra}, {rb}"

# ============================================================
# Primary opcode 7: mulli
# ============================================================
mulli       primary=7 rd:gpr[6:10] ra:gpr[11:15] simm:simm16[16:31]
            | "mulli {rd}, {ra}, {simm}"

# ============================================================
# Primary opcode 8: subfic
# ============================================================
subfic      primary=8 rd:gpr[6:10] ra:gpr[11:15] simm:simm16[16:31]
            | "subfic {rd}, {ra}, {simm}"

# ============================================================
# Primary opcodes 10-15: Compare/Arithmetic D-form
# ============================================================
cmpli       primary=10 crfd:d3[6:8] [9]=0 l:d1[10] ra:gpr[11:15] uimm:uimm[16:31]
            | l == 0 && crfd == 0 : "cmplwi {ra}, {uimm}"
            | l == 0              : "cmplwi cr{crfd}, {ra}, {uimm}"
            | "cmpli {crfd}, {l}, {ra}, {uimm}"

cmpi        primary=11 crfd:d3[6:8] [9]=0 l:d1[10] ra:gpr[11:15] simm:simm16[16:31]
            | l == 0 && crfd == 0 : "cmpwi {ra}, {simm}"
            | l == 0              : "cmpwi cr{crfd}, {ra}, {simm}"
            | "cmpi {crfd}, {l}, {ra}, {simm}"

addic       primary=12 rd:gpr[6:10] ra:gpr[11:15] simm:simm16[16:31]
            nsimm:i32 = -sign_extend(simm, 16)
            | simm < 0 : "subic {rd}, {ra}, {nsimm:#x}"
            | "addic {rd}, {ra}, {simm}"

addic_dot   primary=13 rd:gpr[6:10] ra:gpr[11:15] simm:simm16[16:31]
            nsimm:i32 = -sign_extend(simm, 16)
            | simm < 0 : "subic. {rd}, {ra}, {nsimm:#x}"
            | "addic. {rd}, {ra}, {simm}"

addi        primary=14 rd:gpr[6:10] ra:gpr[11:15] simm:simm16[16:31]
            nsimm:i32 = -sign_extend(simm, 16)
            | ra == 0  : "li {rd}, {simm}"
            | simm < 0 : "subi {rd}, {ra}, {nsimm:#x}"
            | "addi {rd}, {ra}, {simm}"

addis       primary=15 rd:gpr[6:10] ra:gpr[11:15] simm:simm16[16:31]
            nsimm:i32 = -sign_extend(simm, 16)
            | ra == 0  : "lis {rd}, {simm}"
            | simm < 0 : "subis {rd}, {ra}, {nsimm:#x}"
            | "addis {rd}, {ra}, {simm}"

# ============================================================
# Primary opcode 16: bcx (Branch Conditional)
# ============================================================
bcx         primary=16 bo:d5[6:10] bi:d5[11:15] bd:branch_disp[16:29] aa:bool[30] lk:bool[31]
            bct:bc_true  = bi % 4
            bcf:bc_false = bi % 4
            bihi:u3 = bi / 4
            boodd:u1 = bo % 2
            | bo >= 12 && bo <= 15 : "b{bct}{boodd?+}{lk?l}{aa?a} {bihi?cr{bihi:d}, :}{bd}"
            | bo >= 4  && bo <= 7  : "b{bcf}{boodd?+}{lk?l}{aa?a} {bihi?cr{bihi:d}, :}{bd}"
            | bo >= 16 && bo <= 17 : "bdnz{boodd?+}{lk?l}{aa?a} {bd}"
            | bo >= 18 && bo <= 19 : "bdz{boodd?+}{lk?l}{aa?a} {bd}"
            | "bc{lk?l}{aa?a} {bo}, {bi}, {bd}"

# ============================================================
# Primary opcode 17: sc (System Call)
# ============================================================
sc          primary=17 [6:29]=0 [30]=1 [31]=0
            | "sc"

# ============================================================
# Primary opcode 18: bx (Branch)
# ============================================================
bx          primary=18 li:simm24[6:29] aa:bool[30] lk:bool[31]
            | "b{lk?l}{aa?a} {li}"

# ============================================================
# Primary opcode 19: XL-form (Branch to LR/CTR, CR ops, etc.)
# ============================================================
mcrf        primary=19 crfd:d3[6:8] [9:10]=0 crfs:d3[11:13] [14:20]=0 [21:30]=0 [31]=0
            | "mcrf cr{crfd}, cr{crfs}"

bclrx       primary=19 bo:d5[6:10] bi:d5[11:15] [16:20]=0 [21:30]=0b0000010000 lk:bool[31]
            bct:bc_true  = bi % 4
            bcf:bc_false = bi % 4
            bihi:u3 = bi / 4
            boodd:u1 = bo % 2
            | bo == 20 && bi == 0  : "blr{lk?l}"
            | bo >= 12 && bo <= 15 : "b{bct}lr{boodd?+}{lk?l}{bihi? cr{bihi:d}:}"
            | bo >= 4  && bo <= 7  : "b{bcf}lr{boodd?+}{lk?l}{bihi? cr{bihi:d}:}"
            | bo >= 16 && bo <= 17 : "bdnzlr{boodd?+}{lk?l}"
            | bo >= 18 && bo <= 19 : "bdzlr{boodd?+}{lk?l}"
            | "bclr{lk?l} {bo}, {bi}"

crnor       primary=19 crbd:d5[6:10] crba:d5[11:15] crbb:d5[16:20] [21:30]=0b0000100001 [31]=0
            | crba == crbb : "crnot {crbd}, {crba}"
            | "crnor {crbd}, {crba}, {crbb}"

rfi         primary=19 [6:10]=0 [11:15]=0 [16:20]=0 [21:30]=0b0000110010 [31]=0
            | "rfi"

crandc      primary=19 crbd:d5[6:10] crba:d5[11:15] crbb:d5[16:20] [21:30]=0b0010000001 [31]=0
            | "crandc {crbd}, {crba}, {crbb}"

isync       primary=19 [6:10]=0 [11:15]=0 [16:20]=0 [21:30]=0b0010010110 [31]=0
            | "isync"

crxor       primary=19 crbd:d5[6:10] crba:d5[11:15] crbb:d5[16:20] [21:30]=0b0011000001 [31]=0
            | crbd == crba && crba == crbb : "crclr {crbd}"
            | "crxor {crbd}, {crba}, {crbb}"

crnand      primary=19 crbd:d5[6:10] crba:d5[11:15] crbb:d5[16:20] [21:30]=0b0011100001 [31]=0
            | "crnand {crbd}, {crba}, {crbb}"

crand       primary=19 crbd:d5[6:10] crba:d5[11:15] crbb:d5[16:20] [21:30]=0b0100000001 [31]=0
            | "crand {crbd}, {crba}, {crbb}"

creqv       primary=19 crbd:d5[6:10] crba:d5[11:15] crbb:d5[16:20] [21:30]=0b0100100001 [31]=0
            | crbd == crba && crba == crbb : "crset {crbd}"
            | "creqv {crbd}, {crba}, {crbb}"

crorc       primary=19 crbd:d5[6:10] crba:d5[11:15] crbb:d5[16:20] [21:30]=0b0110100001 [31]=0
            | "crorc {crbd}, {crba}, {crbb}"

cror        primary=19 crbd:d5[6:10] crba:d5[11:15] crbb:d5[16:20] [21:30]=0b0111000001 [31]=0
            | crba == crbb : "crmove {crbd}, {crba}"
            | "cror {crbd}, {crba}, {crbb}"

bcctrx      primary=19 bo:d5[6:10] bi:d5[11:15] [16:20]=0 [21:30]=0b1000010000 lk:bool[31]
            bct:bc_true  = bi % 4
            bcf:bc_false = bi % 4
            bihi:u3 = bi / 4
            boodd:u1 = bo % 2
            | bo == 20 && bi == 0  : "bctr{lk?l}"
            | bo >= 12 && bo <= 15 : "b{bct}ctr{boodd?+}{lk?l}{bihi? cr{bihi:d}:}"
            | bo >= 4  && bo <= 7  : "b{bcf}ctr{boodd?+}{lk?l}{bihi? cr{bihi:d}:}"
            | "bcctr{lk?l} {bo}, {bi}"

# ============================================================
# Primary opcodes 20-21, 23: Rotate M-form
# ============================================================
rlwimix     primary=20 rs:gpr[6:10] ra:gpr[11:15] sh:d5[16:20] mb:d5[21:25] me:d5[26:30] rc:bool[31]
            ins_n:u8 = me - mb + 1
            | sh == 32 - mb && me >= mb : "inslwi{rc?.} {ra}, {rs}, {ins_n:d}, {mb}"
            | sh == 31 - me && me >= mb : "insrwi{rc?.} {ra}, {rs}, {ins_n:d}, {mb}"
            | "rlwimi{rc?.} {ra}, {rs}, {sh}, {mb}, {me}"

rlwinmx     primary=21 rs:gpr[6:10] ra:gpr[11:15] sh:d5[16:20] mb:d5[21:25] me:d5[26:30] rc:bool[31]
            clrrwi_n:u8   = 31 - me
            extlwi_n:u8   = me + 1
            clrlslwi_n:u8 = mb + sh
            extrwi_n:u8   = 32 - mb
            extrwi_b:u8   = sh + mb - 32
            | mb == 0 && me == 31       : "rotlwi{rc?.} {ra}, {rs}, {sh}"
            | mb == 0 && me == 31 - sh  : "slwi{rc?.} {ra}, {rs}, {sh}"
            | me == 31 && sh == 32 - mb : "srwi{rc?.} {ra}, {rs}, {mb}"
            | sh == 0 && mb == 0        : "clrrwi{rc?.} {ra}, {rs}, {clrrwi_n:d}"
            | sh == 0 && me == 31       : "clrlwi{rc?.} {ra}, {rs}, {mb}"
            | mb == 0                   : "extlwi{rc?.} {ra}, {rs}, {extlwi_n:d}, {sh}"
            | me == 31 - sh             : "clrlslwi{rc?.} {ra}, {rs}, {clrlslwi_n:d}, {sh}"
            | me == 31 && sh + mb >= 32 : "extrwi{rc?.} {ra}, {rs}, {extrwi_n:d}, {extrwi_b:d}"
            | "rlwinm{rc?.} {ra}, {rs}, {sh}, {mb}, {me}"

rlwnmx      primary=23 uses X_RS mb:d5[21:25] me:d5[26:30] rc:bool[31]
            | mb == 0 && me == 31 : "rotlw{rc?.} {ra}, {rs}, {rb}"
            | "rlwnm{rc?.} {ra}, {rs}, {rb}, {mb}, {me}"

# ============================================================
# Primary opcodes 24-29: Logical Immediate D-form
# ============================================================
ori         primary=24 rs:gpr[6:10] ra:gpr[11:15] uimm:uimm[16:31]
            | rs == 0 && ra == 0 && uimm == 0 : "nop"
            | "ori {ra}, {rs}, {uimm}"

oris        primary=25 rs:gpr[6:10] ra:gpr[11:15] uimm:uimm[16:31]
            | "oris {ra}, {rs}, {uimm}"

xori        primary=26 rs:gpr[6:10] ra:gpr[11:15] uimm:uimm[16:31]
            | "xori {ra}, {rs}, {uimm}"

xoris       primary=27 rs:gpr[6:10] ra:gpr[11:15] uimm:uimm[16:31]
            | "xoris {ra}, {rs}, {uimm}"

andi_dot    primary=28 rs:gpr[6:10] ra:gpr[11:15] uimm:uimm[16:31]
            | "andi. {ra}, {rs}, {uimm}"

andis_dot   primary=29 rs:gpr[6:10] ra:gpr[11:15] uimm:uimm[16:31]
            | "andis. {ra}, {rs}, {uimm}"

# ============================================================
# Primary opcode 31: X-form and XO-form
# ============================================================

# --- Integer Compare X-form ---
cmp         primary=31 crfd:d3[6:8] [9]=0 l:d1[10] ra:gpr[11:15] rb:gpr[16:20] [21:30]=0 [31]=0
            | l == 0 && crfd == 0 : "cmpw {ra}, {rb}"
            | l == 0              : "cmpw cr{crfd}, {ra}, {rb}"
            | "cmp {crfd}, {l}, {ra}, {rb}"

# --- Trap X-form ---
tw          primary=31 to:d5[6:10] ra:gpr[11:15] rb:gpr[16:20] [21:30]=0b0000000100 [31]=0
            | to == 31 && ra == 0 && rb == 0 : "trap"
            | "tw {to}, {ra}, {rb}"

# --- Integer Arithmetic XO-form (9-bit XO at [22:30]) ---
subfcx      primary=31 uses XO [22:30]=0b000001000
            | "subfc{oe?o}{rc?.} {rd}, {ra}, {rb}"

mulhwux     primary=31 uses X_RD [21]=0 [22:30]=0b000001011 rc:bool[31]
            | "mulhwu{rc?.} {rd}, {ra}, {rb}"

addcx       primary=31 uses XO [22:30]=0b000001010
            | "addc{oe?o}{rc?.} {rd}, {ra}, {rb}"

lwarx       primary=31 uses X_RD [21:30]=0b0000010100 [31]=0
            | "lwarx {rd}, {ra}, {rb}"

lwzx        primary=31 uses X_RD [21:30]=0b0000010111 [31]=0
            | "lwzx {rd}, {ra}, {rb}"

slwx        primary=31 uses X_RS [21:30]=0b0000011000 rc:bool[31]
            | "slw{rc?.} {ra}, {rs}, {rb}"

cntlzwx     primary=31 rs:gpr[6:10] ra:gpr[11:15] [16:20]=0 [21:30]=0b0000011010 rc:bool[31]
            | "cntlzw{rc?.} {ra}, {rs}"

