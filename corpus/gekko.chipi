mtspr       primary=31 rs:gpr[6:10] spr:u10[11:20] [21:30]=0b0111010011 [31]=0
            sprn:spr_name = spr % 32 * 32 + spr / 32
            | spr == 256 : "mtlr {rs}"
            | spr == 288 : "mtctr {rs}"
            | spr == 32  : "mtxer {rs}"
            | "mtspr {sprn}, {rs}"

