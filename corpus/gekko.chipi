psq_st      primary=60 fs:fpr[6:10] ra:gpr[11:15] wq:d1[16] iq:d3[17:19] dq:simm12[20:31]
            | "psq_st {fs}, {dq}({ra}), {wq}, {iq}"

psq_stu     primary=61 fs:fpr[6:10] ra:gpr[11:15] wq:d1[16] iq:d3[17:19] dq:simm12[20:31]
            | "psq_stu {fs}, {dq}({ra}), {wq}, {iq}"

