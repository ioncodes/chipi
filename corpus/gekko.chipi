            | "tlbia"

mftb        primary=31 rd:gpr[6:10] tbr:u10[11:20] [21:30]=0b0101110011 [31]=0
            tbrn:u16 = tbr % 32 * 32 + tbr / 32
            | tbr == 392 : "mftb {rd}"
            | tbr == 424 : "mftbu {rd}"
            | "mftb {rd}, {tbrn:d}"

lhaux       primary=31 uses X_RD [21:30]=0b0101110111 [31]=0
            | "lhaux {rd}, {ra}, {rb}"

sthx        primary=31 uses X_RS [21:30]=0b0110010111 [31]=0
            | "sthx {rs}, {ra}, {rb}"

orcx        primary=31 uses X_RS [21:30]=0b0110011100 rc:bool[31]
