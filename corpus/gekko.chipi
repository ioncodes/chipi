xorx        primary=31 uses X_RS [21:30]=0b0100111100 rc:bool[31]
            | "xor{rc?.} {ra}, {rs}, {rb}"

mfspr       primary=31 rd:gpr[6:10] spr:u10[11:20] [21:30]=0b0101010011 [31]=0
            sprn:spr_name = spr % 32 * 32 + spr / 32
            | spr == 256 : "mflr {rd}"
            | spr == 288 : "mfctr {rd}"
            | spr == 32  : "mfxer {rd}"
            | "mfspr {rd}, {sprn}"

lhax        primary=31 uses X_RD [21:30]=0b0101010111 [31]=0
            | "lhax {rd}, {ra}, {rb}"

