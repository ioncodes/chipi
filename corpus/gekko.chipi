# ============================================================
# Primary opcodes 32-55: Load/Store D-form
# ============================================================
lwz         primary=32 uses D_LD
            | "lwz {rd}, {d}({ra})"

lwzu        primary=33 uses D_LD
            | "lwzu {rd}, {d}({ra})"

lbz         primary=34 uses D_LD
            | "lbz {rd}, {d}({ra})"

lbzu        primary=35 uses D_LD
            | "lbzu {rd}, {d}({ra})"

stw         primary=36 uses D_ST
            | "stw {rs}, {d}({ra})"

stwu        primary=37 uses D_ST
            | "stwu {rs}, {d}({ra})"

stb         primary=38 uses D_ST
            | "stb {rs}, {d}({ra})"

stbu        primary=39 uses D_ST
            | "stbu {rs}, {d}({ra})"

lhz         primary=40 uses D_LD
            | "lhz {rd}, {d}({ra})"

lhzu        primary=41 uses D_LD
            | "lhzu {rd}, {d}({ra})"

lha         primary=42 uses D_LD
            | "lha {rd}, {d}({ra})"

lhau        primary=43 uses D_LD
            | "lhau {rd}, {d}({ra})"

sth         primary=44 uses D_ST
            | "sth {rs}, {d}({ra})"

sthu        primary=45 uses D_ST
            | "sthu {rs}, {d}({ra})"

lmw         primary=46 uses D_LD
            | "lmw {rd}, {d}({ra})"

stmw        primary=47 uses D_ST
            | "stmw {rs}, {d}({ra})"

# FP Load D-form
lfs         primary=48 fd:fpr[6:10] ra:gpr[11:15] d:disp[16:31]
            | "lfs {fd}, {d}({ra})"

lfsu        primary=49 fd:fpr[6:10] ra:gpr[11:15] d:disp[16:31]
            | "lfsu {fd}, {d}({ra})"

lfd         primary=50 fd:fpr[6:10] ra:gpr[11:15] d:disp[16:31]
            | "lfd {fd}, {d}({ra})"

lfdu        primary=51 fd:fpr[6:10] ra:gpr[11:15] d:disp[16:31]
            | "lfdu {fd}, {d}({ra})"

# FP Store D-form
stfs        primary=52 fs:fpr[6:10] ra:gpr[11:15] d:disp[16:31]
            | "stfs {fs}, {d}({ra})"

stfsu       primary=53 fs:fpr[6:10] ra:gpr[11:15] d:disp[16:31]
            | "stfsu {fs}, {d}({ra})"

stfd        primary=54 fs:fpr[6:10] ra:gpr[11:15] d:disp[16:31]
            | "stfd {fs}, {d}({ra})"

stfdu       primary=55 fs:fpr[6:10] ra:gpr[11:15] d:disp[16:31]
            | "stfdu {fs}, {d}({ra})"

# ============================================================
# Primary opcodes 56-57: Paired Singles Quantized Load
# ============================================================
psq_l       primary=56 fd:fpr[6:10] ra:gpr[11:15] wq:d1[16] iq:d3[17:19] dq:simm12[20:31]
            | "psq_l {fd}, {dq}({ra}), {wq}, {iq}"

psq_lu      primary=57 fd:fpr[6:10] ra:gpr[11:15] wq:d1[16] iq:d3[17:19] dq:simm12[20:31]
            | "psq_lu {fd}, {dq}({ra}), {wq}, {iq}"

# ============================================================
# Primary opcode 59: FP Single Arithmetic A-form
# ============================================================
fdivsx      primary=59 uses FPR3 [21:25]=0 [26:30]=0b10010
            | "fdivs{rc?.} {fd}, {fa}, {fb}"

fsubsx      primary=59 uses FPR3 [21:25]=0 [26:30]=0b10100
            | "fsubs{rc?.} {fd}, {fa}, {fb}"

faddsx      primary=59 uses FPR3 [21:25]=0 [26:30]=0b10101
            | "fadds{rc?.} {fd}, {fa}, {fb}"

fsqrtsx     primary=59 fd:fpr[6:10] [11:15]=0 fb:fpr[16:20] [21:25]=0 [26:30]=0b10110 rc:bool[31]
            | "fsqrts{rc?.} {fd}, {fb}"

fresx       primary=59 fd:fpr[6:10] [11:15]=0 fb:fpr[16:20] [21:25]=0 [26:30]=0b11000 rc:bool[31]
            | "fres{rc?.} {fd}, {fb}"

fmulsx      primary=59 fd:fpr[6:10] fa:fpr[11:15] [16:20]=0 fc:fpr[21:25] [26:30]=0b11001 rc:bool[31]
            | "fmuls{rc?.} {fd}, {fa}, {fc}"

fmsubsx     primary=59 uses FPR4 [26:30]=0b11100
            | "fmsubs{rc?.} {fd}, {fa}, {fc}, {fb}"

fmaddsx     primary=59 uses FPR4 [26:30]=0b11101
            | "fmadds{rc?.} {fd}, {fa}, {fc}, {fb}"

fnmsubsx    primary=59 uses FPR4 [26:30]=0b11110
            | "fnmsubs{rc?.} {fd}, {fa}, {fc}, {fb}"

fnmaddsx    primary=59 uses FPR4 [26:30]=0b11111
            | "fnmadds{rc?.} {fd}, {fa}, {fc}, {fb}"

# ============================================================
# Primary opcodes 60-61: Paired Singles Quantized Store
